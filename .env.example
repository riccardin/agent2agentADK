# Copy to .env and fill in the values: cp .env.example .env
# One .env at the repo root is used by both agent packages.
# Keep exactly ONE "Model" option below uncommented.

# --- Model option A: Claude via the Anthropic API (default) -------------------
# Any MODEL starting with "anthropic/" is routed through LiteLLM to Anthropic.
MODEL=anthropic/claude-sonnet-5-5
ANTHROPIC_API_KEY=your-anthropic-api-key

# --- Model option B: Gemini via Vertex AI ------------------------------------
# Uses your Google Cloud project + ADC / service account.
# MODEL=gemini-2.5-flash
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# --- Model option C: Gemini via a Google AI Studio API key -------------------
# MODEL=gemini-2.5-flash
# GOOGLE_GENAI_USE_VERTEXAI=FALSE
# GOOGLE_API_KEY=your-gemini-api-key

# --- Google Cloud Logging (optional, works with any model option) ------------
# Agents fall back to standard Python logging when this isn't configured.
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/service-account-key.json

# --- Corporate proxy / Zscaler (optional) ------------------------------------
# Combined CA bundle (certifi + Zscaler root CA); see README "Networking Behind Zscaler".
# REQUESTS_CA_BUNDLE=/absolute/path/to/.certs/combined-ca.pem
# SSL_CERT_FILE=/absolute/path/to/.certs/combined-ca.pem
